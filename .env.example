# Copy to .env and fill in. Nothing here is loaded from source control.

# --- LLM providers ---
# Any one of these is enough for real runs; every key can also be added
# from the Settings screen (/settings.html#keys) instead. A seat routed to
# a provider with no key uses one you do have a key for.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free keys: Gemini (aistudio.google.com/apikey) and Groq
# (console.groq.com/keys). Turn on Free Mode in Settings -> Models & Cost
# to put every seat on their free tiers; Groq takes over automatically when
# Gemini's free daily limit runs out mid-run.
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Data providers ---
# Not wired into the live provider chain (see council/config.py) -- its
# free tier's 25-requests/day cap made it structurally unusable, and its
# options endpoints require a paid ($199.99+/month) plan regardless of
# quota. Setting this does nothing; left here only in case a premium key
# gets wired back in later.
ALPHA_VANTAGE_API_KEY=
# SEC EDGAR needs no key, but every request must carry a real contact per
# SEC's fair-access policy (https://www.sec.gov/os/webmaster-faq#developers)
# -- e.g. "YourApp your-real-email@example.com". Leaving this blank risks a
# 403 or an IP ban once you're making real requests.
SEC_EDGAR_USER_AGENT=
# Free (https://fred.stlouisfed.org/docs/api/api_key.html), 120 req/min
# with no hard daily cap -- the ONLY source for macro data (treasury
# yields, fed funds rate, CPI, unemployment, dollar index, WTI crude) in
# this chain. Without this, macro_sage has no live source at all and
# abstains every run.
FRED_API_KEY=

# --- Behaviour toggles ---
# Forced on automatically when no AI key at all is set (Anthropic, OpenAI,
# Gemini or Groq). Set explicitly to force fixture-mode seat verdicts even
# with a key present (useful for tests).
NO_LLM=

# Market data (yfinance, SEC EDGAR, FRED) is free and live whenever any AI
# key is set; with no AI key at all, the recorded NVDA sample data is used
# alongside the sample answers. Set explicitly to override either way.
USE_DATA_FIXTURES=

# --- Storage ---
COUNCIL_DB_PATH=./data/council.db
CACHE_DB_PATH=./data/cache.db

# --- Accounts ---
# Blank (the default) means no sign-in at all and a single user -- fine on
# your own machine/LAN, NOT fine on the public internet. Set it to turn on
# accounts: the first visit then asks for this password once to create the
# owner's account; after that everyone signs in with their own email and
# password (or Google), and new sign-ups wait for the owner's approval on
# the admin page. Whitespace-only doesn't count as blank.
APP_PASSWORD=
# The site's public address, used in emails and for Google sign-in.
PUBLIC_URL=
# Encrypts saved API keys. Blank = a random one kept in data/secret.key
# (back that file up with the databases -- without it, saved keys can't be
# read and have to be pasted in again).
SECRET_KEY=
# Emails (sign-up alerts, "you're approved", password resets) via Resend.
# Blank = no emails; the admin page can make reset links to pass on.
RESEND_API_KEY=
EMAIL_FROM=
# "Continue with Google". Blank = hidden. Redirect URI to register:
# <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nightly backups (scripts/setup-backups.sh). Optional off-VM copy: an Oracle
# Object Storage pre-authenticated request URL ending in /o/ (README: Backups).
BACKUP_UPLOAD_URL=
COOKIE_SECURE=
