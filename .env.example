# Copy to .env and fill in. Nothing here is loaded from source control.

# --- LLM providers ---
ANTHROPIC_API_KEY=
# Optional: activates the seats routed to these providers in
# config/models.yaml, or any seat you've reassigned to one of these
# providers from the Settings pane (/settings.html). Leaving a key blank
# just falls back that seat to Anthropic -- it doesn't error.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Data providers ---
# Not wired into the live provider chain (see council/config.py) -- its
# free tier's 25-requests/day cap made it structurally unusable, and its
# options endpoints require a paid ($199.99+/month) plan regardless of
# quota. Setting this does nothing; left here only in case a premium key
# gets wired back in later.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
# SEC EDGAR needs no key, but every request must carry a real contact per
# SEC's fair-access policy (https://www.sec.gov/os/webmaster-faq#developers)
# -- e.g. "YourApp your-real-email@example.com". Leaving this blank risks a
# 403 or an IP ban once you're making real requests.
SEC_EDGAR_USER_AGENT=
# Free (https://fred.stlouisfed.org/docs/api/api_key.html), 120 req/min
# with no hard daily cap -- the ONLY source for macro data (treasury
# yields, fed funds rate, CPI, unemployment, dollar index, WTI crude) in
# this chain. Without this, macro_sage has no live source at all and
# abstains every run.
FRED_API_KEY=

# --- Behaviour toggles ---
# Forced on automatically when ANTHROPIC_API_KEY is empty. Set explicitly to
# force fixture-mode seat verdicts even with a key present (useful for tests).
NO_LLM=

# Forced on automatically when FMP_API_KEY is empty. Set explicitly to
# force recorded market-data fixtures over live calls -- note this only
# gates FMP; yfinance and SEC EDGAR are free/keyless and always live
# unless this is explicitly set to true.
USE_DATA_FIXTURES=

# --- Storage ---
COUNCIL_DB_PATH=./data/council.db
CACHE_DB_PATH=./data/cache.db
