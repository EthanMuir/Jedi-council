# Copy to .env and fill in. Nothing here is loaded from source control.

# --- LLM providers ---
ANTHROPIC_API_KEY=
# Optional: activates the seats routed to these providers in
# config/models.yaml, or any seat you've reassigned to one of these
# providers from the Settings pane (/settings.html). Leaving a key blank
# just falls back that seat to Anthropic -- it doesn't error.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Data providers ---
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
# SEC EDGAR needs no key, but every request must carry a real contact per
# SEC's fair-access policy (https://www.sec.gov/os/webmaster-faq#developers)
# -- e.g. "YourApp your-real-email@example.com". Leaving this blank risks a
# 403 or an IP ban once you're making real requests.
SEC_EDGAR_USER_AGENT=
# Free (https://fred.stlouisfed.org/docs/api/api_key.html), 120 req/min
# with no hard daily cap -- the alternative to Alpha Vantage for macro
# data (treasury yields, fed funds rate, CPI, unemployment, dollar index,
# WTI crude), the one domain nothing else in the chain covers. Alpha
# Vantage's free tier caps at 25 requests/day total and a single macro
# fetch alone burns 7 of them -- set this and macro_sage stops depending
# on that budget at all.
FRED_API_KEY=

# --- Behaviour toggles ---
# Forced on automatically when ANTHROPIC_API_KEY is empty. Set explicitly to
# force fixture-mode seat verdicts even with a key present (useful for tests).
NO_LLM=

# Forced on automatically when both ALPHA_VANTAGE_API_KEY and FMP_API_KEY are
# empty. Set explicitly to force recorded market-data fixtures over live calls.
USE_DATA_FIXTURES=

# --- Storage ---
COUNCIL_DB_PATH=./data/council.db
CACHE_DB_PATH=./data/cache.db
